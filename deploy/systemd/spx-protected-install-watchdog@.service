[Unit]
Description=SPX protected production install watchdog (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/node /var/lib/spx-protected-install/watchdogs/%i/scripts/protected-install-watchdog.mjs --action=reconcile-loop
Restart=always
RestartSec=2
RuntimeDirectory=spx-protected-install
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/lib/spx-gate6/gate6-control-db.json /var/lib/spx-gate6/secrets/gate6-control-db-password /var/lib/spx-gate6/config/db-ca.pem /var/lib/spx-protected-install/watchdogs/%i
ReadWritePaths=/var/lib/spx-production-mutation
UMask=0077

[Install]
WantedBy=multi-user.target
