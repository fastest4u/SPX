{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spx.invalid/schemas/gate6-envelope.schema.json",
  "title": "SPX Gate 6 signed production envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gate6Id",
    "releaseEnvironment",
    "runtimeEnvironment",
    "drillMode",
    "candidateSha",
    "candidateImageDigest",
    "rollbackSha",
    "rollbackImageDigest",
    "releaseManifestSha256",
    "productionTargetDescriptorSha256",
    "stagingTargetDescriptorSha256",
    "operatorBundleSha256",
    "installedOperatorBundleSha256",
    "topology",
    "serviceSetSha256",
    "productionDatabaseFingerprint",
    "productionProviderTargetFingerprints",
    "composeProject",
    "envFile",
    "composeFiles",
    "stagingBundles",
    "backupEvidenceSha256",
    "rpoMinutes",
    "rtoMinutes",
    "canaryTeamId",
    "canaryEpoch",
    "safeLineTargetSha256",
    "ocrFixtureSha256",
    "gate6Nonce",
    "monitorThresholdsSha256",
    "protectedInstallEvidenceSha256",
    "installedMigrationSetSha256",
    "installedSchemaVersion",
    "pendingReleasedMigrationCount",
    "issuedAt",
    "expiresAt",
    "approver",
    "githubAttestation",
    "envelopeCoreSha256",
    "actionIndexSha256",
    "actionApprovals",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gate6Id": { "$ref": "#/$defs/id" },
    "releaseEnvironment": { "const": "production" },
    "runtimeEnvironment": { "const": "production" },
    "drillMode": { "const": "supervised-production" },
    "candidateSha": { "$ref": "#/$defs/commitSha" },
    "candidateImageDigest": { "$ref": "#/$defs/imageDigest" },
    "rollbackSha": { "$ref": "#/$defs/commitSha" },
    "rollbackImageDigest": { "$ref": "#/$defs/imageDigest" },
    "releaseManifestSha256": { "$ref": "#/$defs/sha256" },
    "productionTargetDescriptorSha256": { "$ref": "#/$defs/sha256" },
    "stagingTargetDescriptorSha256": { "$ref": "#/$defs/sha256" },
    "operatorBundleSha256": { "$ref": "#/$defs/sha256" },
    "installedOperatorBundleSha256": { "$ref": "#/$defs/sha256" },
    "topology": { "const": "split" },
    "serviceSetSha256": { "$ref": "#/$defs/sha256" },
    "productionDatabaseFingerprint": { "$ref": "#/$defs/imageDigest" },
    "productionProviderTargetFingerprints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/imageDigest" }
    },
    "composeProject": { "const": "spx-production" },
    "envFile": { "const": "/root/SPX/.env" },
    "composeFiles": {
      "const": ["/root/SPX/docker-compose.yml"]
    },
    "stagingBundles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task9Sha256", "workerSha256", "phase3Sha256", "phase4Sha256", "nMinusOneSha256"],
      "properties": {
        "task9Sha256": { "$ref": "#/$defs/sha256" },
        "workerSha256": { "$ref": "#/$defs/sha256" },
        "phase3Sha256": { "$ref": "#/$defs/sha256" },
        "phase4Sha256": { "$ref": "#/$defs/sha256" },
        "nMinusOneSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "backupEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "rpoMinutes": { "type": "integer", "minimum": 1 },
    "rtoMinutes": { "type": "integer", "minimum": 1 },
    "canaryTeamId": { "type": "integer", "minimum": 1 },
    "canaryEpoch": { "$ref": "#/$defs/id" },
    "safeLineTargetSha256": { "$ref": "#/$defs/sha256" },
    "ocrFixtureSha256": { "$ref": "#/$defs/sha256" },
    "gate6Nonce": { "$ref": "#/$defs/id" },
    "monitorThresholdsSha256": { "$ref": "#/$defs/sha256" },
    "protectedInstallEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "installedMigrationSetSha256": { "$ref": "#/$defs/sha256" },
    "installedSchemaVersion": { "type": "integer", "minimum": 1 },
    "pendingReleasedMigrationCount": { "const": 0 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "approver": { "$ref": "#/$defs/id" },
    "githubAttestation": { "$ref": "#/$defs/attestation" },
    "envelopeCoreSha256": { "$ref": "#/$defs/sha256" },
    "actionIndexSha256": { "$ref": "#/$defs/sha256" },
    "actionApprovals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "signedPayloadSha256", "signatureBase64"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "$ref": "#/$defs/id" },
        "signedPayloadSha256": { "$ref": "#/$defs/sha256" },
        "signatureBase64": { "type": "string", "minLength": 1 }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "environment", "jobWorkflowRef", "jobWorkflowSha", "workflowFileSha256", "workflowRunId", "issuer", "audience", "artifactSha256"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "environment": { "const": "production" },
        "jobWorkflowRef": { "type": "string", "minLength": 1 },
        "jobWorkflowSha": { "$ref": "#/$defs/commitSha" },
        "workflowFileSha256": { "$ref": "#/$defs/sha256" },
        "workflowRunId": { "type": "string", "pattern": "^[0-9]+$" },
        "issuer": { "const": "https://token.actions.githubusercontent.com" },
        "audience": { "const": "spx-gate6" },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "permitIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitId", "service", "kind", "teamId", "targetSha256", "fixtureSha256", "releaseOrFixtureSha256", "issuanceNonce"],
      "properties": {
        "permitId": { "$ref": "#/$defs/id" },
        "service": { "enum": ["line-service", "ocr-service"] },
        "kind": { "$ref": "#/$defs/id" },
        "teamId": { "type": "integer", "minimum": 1 },
        "targetSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "fixtureSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "releaseOrFixtureSha256": { "$ref": "#/$defs/sha256" },
        "issuanceNonce": { "$ref": "#/$defs/id" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate6Id", "scope", "kind", "actionId", "envelopeCoreSha256", "candidateSha", "runtimeEnvironment", "drillMode", "allowedMutationSha256", "rollbackScope", "pairedActionId", "issuedAt", "expiresAt", "signature"],
      "properties": {
        "gate6Id": { "$ref": "#/$defs/id" },
        "scope": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["forward", "compensation", "emergency"] },
        "actionId": { "$ref": "#/$defs/id" },
        "envelopeCoreSha256": { "$ref": "#/$defs/sha256" },
        "candidateSha": { "$ref": "#/$defs/commitSha" },
        "runtimeEnvironment": { "const": "production" },
        "drillMode": { "const": "supervised-production" },
        "allowedMutationSha256": { "$ref": "#/$defs/sha256" },
        "rollbackScope": { "type": "string", "minLength": 1 },
        "pairedActionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "permitIntent": { "$ref": "#/$defs/permitIntent" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  }
}
